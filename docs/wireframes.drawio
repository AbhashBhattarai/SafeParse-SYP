      <mxCell id="14" value="&amp;lt;b style=&#x27;font-size:20px;color:#1E293B;&#x27;&amp;gt;UdpHeader &amp;lt;span style=&#x27;color:#64748B;font-weight:normal;&#x27;&amp;gt;(Spec #2)&amp;lt;/span&amp;gt;&amp;lt;/b&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="105" y="200" width="300" height="30" as="geometry" /></mxCell>
      <mxCell id="15" value="← Back to History" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0366D6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="120" height="30" as="geometry" /></mxCell>
      <mxCell id="16" value="Created by &amp;lt;b&amp;gt;abhash&amp;lt;/b&amp;gt; on &amp;lt;code style=&#x27;background:#F1F5F9;padding:2px 4px;&#x27;&amp;gt;2026-10-14 07:13:37&amp;lt;/code&amp;gt; &amp;amp;nbsp;|&amp;amp;nbsp; Database Record ID: #2 &amp;amp;nbsp;|&amp;amp;nbsp; Variants: Naive &amp;amp;amp; Optimized" style="text;html=1;align=left;fontSize=12;fontColor:#64748B;" vertex="1" parent="1"><mxGeometry x="105" y="233" width="650" height="20" as="geometry" /></mxCell>
      <mxCell id="17" value="Specification Source:" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor:#334155;" vertex="1" parent="1"><mxGeometry x="105" y="260" width="200" height="20" as="geometry" /></mxCell>
      <mxCell id="18" value="format UdpHeader {&#xa;    src_port:  u16&#xa;    dst_port:  u16&#xa;    length:    u16&#xa;    checksum:  u16&#xa;    payload:   bytes[length - 8]&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Consolas,monospace;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="105" y="285" width="1390" height="135" as="geometry" /></mxCell>
      <mxCell id="19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;" vertex="1" parent="1"><mxGeometry x="80" y="465" width="707.5" height="580" as="geometry" /></mxCell>
      <mxCell id="20" value="&amp;lt;b style=&#x27;font-size:15px;color:#1E293B;&#x27;&amp;gt;Naive Parser Implementation&amp;lt;/b&amp;gt;" style="text;html=1;align=left;fontSize=14;fontColor:#1E293B;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="250" height="24" as="geometry" /></mxCell>
      <mxCell id="21" value="Naive Mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#FFEBAA;fontColor=#856404;fontSize=11;" vertex="1" parent="1"><mxGeometry x="657.5" y="480" width="90" height="22" as="geometry" /></mxCell>
      <mxCell id="22" value="/* Generated C Code — specs/udp.spec (naive) */&amp;#xa;int parse_UdpHeader(const uint8_t *buf, size_t len, UdpHeader *out) {&amp;#xa;    size_t offset = 0;&amp;#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&amp;#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&amp;#xa;    out-&gt;src_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&amp;#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&amp;#xa;    out-&gt;dst_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    ...&amp;#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E242C;strokeColor=none;fontColor=#E1E4E8;fontFamily=Consolas,monospace;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="100" y="515" width="667.5" height="470" as="geometry" /></mxCell>
      <mxCell id="23" value="📋 Copy Naive C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0366D6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="997" width="110" height="28" as="geometry" /></mxCell>
      <mxCell id="24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;" vertex="1" parent="1"><mxGeometry x="812.5" y="465" width="707.5" height="580" as="geometry" /></mxCell>
      <mxCell id="25" value="&amp;lt;b style=&#x27;font-size:15px;color:#1E293B;&#x27;&amp;gt;Optimized Parser Implementation&amp;lt;/b&amp;gt;" style="text;html=1;align=left;fontSize=14;fontColor:#1E293B;" vertex="1" parent="1"><mxGeometry x="832.5" y="480" width="250" height="24" as="geometry" /></mxCell>
      <mxCell id="26" value="Optimized Mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#C3E6CB;fontColor=#155724;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410.0" y="480" width="100" height="22" as="geometry" /></mxCell>
      <mxCell id="27" value="/* Generated C Code — specs/udp.spec (optimized) */&amp;#xa;int parse_UdpHeader(const uint8_t *buf, size_t len, UdpHeader *out) {&amp;#xa;    size_t offset = 0;&amp;#xa;    /* Merged 8-byte check */&amp;#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&amp;#xa;    if (len - offset &lt; 8) return PARSE_ERR_TOO_SHORT;&amp;#xa;    out-&gt;src_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    out-&gt;dst_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    out-&gt;length   = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    out-&gt;checksum = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&amp;#xa;    offset += 2;&amp;#xa;    ...&amp;#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E242C;strokeColor=none;fontColor=#E1E4E8;fontFamily=Consolas,monospace;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="832.5" y="515" width="667.5" height="470" as="geometry" /></mxCell>
      <mxCell id="28" value="📋 Copy Optimized C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0366D6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="832.5" y="997" width="125" height="28" as="geometry" /></mxCell>
      </root>
