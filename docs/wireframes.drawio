        <mxCell id="2" value="&amp;lt;b style=&#x27;font-size:22px;color:#0F172A;&#x27;&amp;gt;SafeParse Wireframes — Specification Compiler Page (/compile)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;span style=&#x27;font-size:13px;color:#64748B;&#x27;&amp;gt;Interactive DSL input with presets, validation feedback, and side-by-side C code generation diff&amp;lt;/span&amp;gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry" /></mxCell>
      <mxCell id="3" value="" style="swimlane;whiteSpace=wrap;html=1;startSize=40;rounded=1;shadow=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontFamily=Segoe UI;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1520" height="1180" as="geometry" /></mxCell>
      <mxCell id="4" value="&amp;lt;font color=&#x27;#EF4444&#x27;&amp;gt;●&amp;lt;/font&amp;gt; &amp;lt;font color=&#x27;#F59E0B&#x27;&amp;gt;●&amp;lt;/font&amp;gt; &amp;lt;font color=&#x27;#10B981&#x27;&amp;gt;●&amp;lt;/font&amp;gt; &amp;amp;nbsp;&amp;lt;b&amp;gt;SafeParse — Compile Binary Format Specification&amp;lt;/b&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="52" y="88" width="260" height="24" as="geometry" /></mxCell>
      <mxCell id="5" value="🔒 http://127.0.0.1:5000/compile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=12;fontSize=11;fontColor=#475569;fontFamily=Consolas,monospace;" vertex="1" parent="1"><mxGeometry x="620.0" y="88" width="360" height="24" as="geometry" /></mxCell>
      <mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#24292E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1520" height="48" as="geometry" /></mxCell>
      <mxCell id="7" value="&amp;lt;b style=&#x27;font-size:15px;color:#FFFFFF;&#x27;&amp;gt;SafeParse&amp;lt;/b&amp;gt; &amp;lt;span style=&#x27;font-size:11px;color:#959DA5;&#x27;&amp;gt;Memory-Safe C Parser Compiler&amp;lt;/span&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="56" y="128" width="300" height="32" as="geometry" /></mxCell>
      <mxCell id="8" value="Compile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B424A;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="131" width="70" height="26" as="geometry" /></mxCell>
      <mxCell id="9" value="History" style="text;html=1;fontColor=#C9D1D9;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="428" y="131" width="70" height="26" as="geometry" /></mxCell>
      <mxCell id="10" value="Results" style="text;html=1;fontColor=#C9D1D9;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="506" y="131" width="70" height="26" as="geometry" /></mxCell>
      <mxCell id="11" value="&amp;lt;span style=&#x27;color:#58A6FF;font-weight:600;&#x27;&amp;gt;abhash&amp;lt;/span&amp;gt; &amp;lt;span style=&#x27;background-color:#238636;color:#FFFFFF;padding:2px 5px;border-radius:3px;font-size:9px;font-weight:bold;&#x27;&amp;gt;DEVELOPER&amp;lt;/span&amp;gt;" style="text;html=1;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1345" y="128" width="140" height="32" as="geometry" /></mxCell>
      <mxCell id="12" value="Log Out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B424A;strokeColor=#475569;fontColor=#E2E8F0;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1492" y="132" width="56" height="24" as="geometry" /></mxCell>
      <mxCell id="13" value="✅ &amp;amp;nbsp; &amp;lt;b&amp;gt;Success!&amp;lt;/b&amp;gt; Successfully compiled &amp;lt;code style=&#x27;background:#C6F6D5;padding:2px 6px;border-radius:3px;&#x27;&amp;gt;UdpHeader&amp;lt;/code&amp;gt; and saved both &amp;lt;b&amp;gt;naive&amp;lt;/b&amp;gt; and &amp;lt;b&amp;gt;optimized&amp;lt;/b&amp;gt; parsers into SQLite database (#2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFFE4;strokeColor=#85E89D;fontColor=#1A7F37;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="80" y="185" width="1440" height="38" as="geometry" /></mxCell>
      <mxCell id="14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;" vertex="1" parent="1"><mxGeometry x="80" y="235" width="1440" height="350" as="geometry" /></mxCell>
      <mxCell id="15" value="&amp;lt;b style=&#x27;font-size:18px;color:#1E293B;&#x27;&amp;gt;Compile Binary Format Specification&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;span style=&#x27;font-size:12px;color:#64748B;&#x27;&amp;gt;Define a packet or file format in SafeParse DSL. The compiler generates both &amp;lt;b&amp;gt;naive&amp;lt;/b&amp;gt; (check per field) and &amp;lt;b&amp;gt;optimized&amp;lt;/b&amp;gt; (merged checks) C code.&amp;lt;/span&amp;gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="105" y="253" width="900" height="40" as="geometry" /></mxCell>
      <mxCell id="16" value="Presets:" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor:#64748B;" vertex="1" parent="1"><mxGeometry x="105" y="300" width="60" height="22" as="geometry" /></mxCell>
      <mxCell id="17" value="UDP Header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#C7D2FE;fontColor=#3730A3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="300" width="95" height="22" as="geometry" /></mxCell>
      <mxCell id="18" value="PNG IHDR Chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="300" width="115" height="22" as="geometry" /></mxCell>
      <mxCell id="19" value="DNS Header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#475569;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="95" height="22" as="geometry" /></mxCell>
      <mxCell id="20" value="format UdpHeader {&#xa;    src_port:  u16&#xa;    dst_port:  u16&#xa;    length:    u16&#xa;    checksum:  u16&#xa;    payload:   bytes[length - 8]&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Consolas,monospace;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="105" y="333" width="1390" height="160" as="geometry" /></mxCell>
      <mxCell id="21" value="⚡ Compile Both Variants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2EA44F;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="510" width="185" height="42" as="geometry" /></mxCell>
      <mxCell id="22" value="Reset to Default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="305" y="510" width="125" height="42" as="geometry" /></mxCell>
      <mxCell id="23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="707.5" height="610" as="geometry" /></mxCell>
      <mxCell id="24" value="&amp;lt;b style=&#x27;font-size:15px;color:#1E293B;&#x27;&amp;gt;Naive Parser&amp;lt;/b&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="100" y="625" width="150" height="24" as="geometry" /></mxCell>
      <mxCell id="25" value="Check Before Every Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#FFEBAA;fontColor=#856404;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="567.5" y="625" width="160" height="24" as="geometry" /></mxCell>
      <mxCell id="26" value="Performs an explicit bounds check prior to reading each individual field (5 checks total)." style="text;html=1;align=left;fontSize=11;fontColor:#64748B;" vertex="1" parent="1"><mxGeometry x="100" y="652" width="667.5" height="20" as="geometry" /></mxCell>
      <mxCell id="27" value="int parse_UdpHeader(const uint8_t *buf, size_t len, UdpHeader *out) {&#xa;    size_t offset = 0;&#xa;&#xa;    /* Bounds check for: src_port (2 bytes) */&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&#xa;    out-&gt;src_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;&#xa;    /* Bounds check for: dst_port (2 bytes) */&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&#xa;    out-&gt;dst_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;&#xa;    /* Bounds check for: length (2 bytes) */&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&#xa;    out-&gt;length = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;&#xa;    /* Bounds check for: checksum (2 bytes) */&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; 2) return PARSE_ERR_TOO_SHORT;&#xa;    out-&gt;checksum = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;&#xa;    /* Read variable-length payload */&#xa;    if (!(out-&gt;length &gt;= 8)) return PARSE_ERR_BAD_LENGTH;&#xa;    size_t payload_len = (size_t)((out-&gt;length - 8));&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; payload_len) return PARSE_ERR_TOO_SHORT;&#xa;    ...&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E242C;strokeColor=none;fontColor=#E1E4E8;fontFamily=Consolas,monospace;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="100" y="680" width="667.5" height="480" as="geometry" /></mxCell>
      <mxCell id="28" value="📋 Copy C Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0366D6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1172" width="110" height="30" as="geometry" /></mxCell>
      <mxCell id="29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;shadow=1;" vertex="1" parent="1"><mxGeometry x="812.5" y="610" width="707.5" height="610" as="geometry" /></mxCell>
      <mxCell id="30" value="&amp;lt;b style=&#x27;font-size:15px;color:#1E293B;&#x27;&amp;gt;Optimized Parser&amp;lt;/b&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="832.5" y="625" width="160" height="24" as="geometry" /></mxCell>
      <mxCell id="31" value="Merged Consecutive Checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#C3E6CB;fontColor=#155724;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320.0" y="625" width="180" height="24" as="geometry" /></mxCell>
      <mxCell id="32" value="Combines contiguous fixed-size checks into 1 single bounds check (2 checks total, +9.3% faster)." style="text;html=1;align=left;fontSize=11;fontColor:#64748B;" vertex="1" parent="1"><mxGeometry x="832.5" y="652" width="667.5" height="20" as="geometry" /></mxCell>
      <mxCell id="33" value="int parse_UdpHeader(const uint8_t *buf, size_t len, UdpHeader *out) {&#xa;    size_t offset = 0;&#xa;&#xa;    /* Bounds check for: src_port, dst_port, length, checksum (8 bytes) */&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; 8) return PARSE_ERR_TOO_SHORT;&#xa;&#xa;    out-&gt;src_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;    out-&gt;dst_port = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;    out-&gt;length = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;    out-&gt;checksum = (uint16_t)(((uint16_t)buf[offset] &lt;&lt; 8) | buf[offset + 1]);&#xa;    offset += 2;&#xa;&#xa;    /* Read variable-length payload */&#xa;    if (!(out-&gt;length &gt;= 8)) return PARSE_ERR_BAD_LENGTH;&#xa;    size_t payload_len = (size_t)((out-&gt;length - 8));&#xa;    if (offset &gt; len) return PARSE_ERR_TOO_SHORT;&#xa;    if (len - offset &lt; payload_len) return PARSE_ERR_TOO_SHORT;&#xa;    out-&gt;payload = buf + offset;&#xa;    out-&gt;payload_len = payload_len;&#xa;    offset += payload_len;&#xa;&#xa;    return PARSE_OK;&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E242C;strokeColor=none;fontColor=#E1E4E8;fontFamily=Consolas,monospace;fontSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="832.5" y="680" width="667.5" height="480" as="geometry" /></mxCell>
      <mxCell id="34" value="📋 Copy C Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#0366D6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="832.5" y="1172" width="110" height="30" as="geometry" /></mxCell>
      <mxCell id="35" value="⚡ ~9-12% Faster in Benchmarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFFE4;strokeColor=#85E89D;fontColor=#166534;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280.0" y="1172" width="220" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
